#!/bin/busybox sh

# PID 1 for the first shennong Kali bring-up. The stock vendor ramdisk is
# concatenated by the Android boot flow and supplies /lib/modules.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root

BB=/bin/busybox
ROOT_MOUNT=/newroot
MODULE_DIR=/lib/modules
FIRMWARE_PATHS=/vendor/firmware_mnt/image,/vendor/firmware_mnt/image/kiwi,/vendor/modem_firmware/image

log() {
    message="shennong-init: $*"
    "$BB" echo "$message" >/dev/kmsg 2>/dev/null || true
    if [ -w /dev/pmsg0 ]; then
        "$BB" echo "$message" >/dev/pmsg0 2>/dev/null || true
    fi
    "$BB" echo "$message"
}

emergency_shell() {
    log "$*"
    log "Dropping to the initramfs shell; slot A has not been modified."
    exec "$BB" sh
}

"$BB" --install -s /bin
mkdir -p /dev /dev/pts /proc /sys /run "$ROOT_MOUNT"
mount -t devtmpfs devtmpfs /dev || emergency_shell "cannot mount devtmpfs"
mount -t devpts devpts /dev/pts || true
mount -t proc proc /proc || emergency_shell "cannot mount proc"
mount -t sysfs sysfs /sys || emergency_shell "cannot mount sysfs"
mount -t tmpfs tmpfs /run || true

find_partition() {
    partition_name="$1"
    for candidate in \
        "/dev/block/by-name/$partition_name" \
        "/dev/block/bootdevice/by-name/$partition_name" \
        "/dev/disk/by-partlabel/$partition_name"; do
        [ -b "$candidate" ] && {
            printf '%s\n' "$candidate"
            return 0
        }
    done

    for uevent in /sys/class/block/*/uevent; do
        [ -r "$uevent" ] || continue
        if grep -qx "PARTNAME=$partition_name" "$uevent"; then
            block_name=${uevent%/uevent}
            block_name=${block_name##*/}
            for candidate in "/dev/block/$block_name" "/dev/$block_name"; do
                [ -b "$candidate" ] && {
                    printf '%s\n' "$candidate"
                    return 0
                }
            done
        fi
    done
    return 1
}

linux_root=
firmware_partition=
modem_firmware_partition=
attempt=0
while [ "$attempt" -lt 40 ]; do
    mdev -s 2>/dev/null || true
    linux_root=$(find_partition linux_root) || true
    firmware_partition=$(find_partition modem_a) || true
    modem_firmware_partition=$(find_partition modemfirmware_a) || true
    [ -n "$linux_root" ] && [ -n "$firmware_partition" ] && \
        [ -n "$modem_firmware_partition" ] && break
    attempt=$((attempt + 1))
    sleep 1
done

[ -n "$linux_root" ] || emergency_shell "linux_root did not appear"

mkdir -p /vendor/firmware_mnt /vendor/modem_firmware
if [ -n "$firmware_partition" ]; then
    mount -t vfat -o ro,nosuid,nodev,noexec "$firmware_partition" \
        /vendor/firmware_mnt || log "failed to mount $firmware_partition"
else
    log "modem_a did not appear; early firmware is unavailable"
fi
if [ -n "$modem_firmware_partition" ]; then
    mount -t vfat -o ro,nosuid,nodev,noexec "$modem_firmware_partition" \
        /vendor/modem_firmware || log "failed to mount $modem_firmware_partition"
else
    log "modemfirmware_a did not appear"
fi
ln -sfn firmware_mnt/image /vendor/firmware

if [ -w /sys/module/firmware_class/parameters/path ] && \
   [ -d /vendor/firmware_mnt/image ]; then
    printf '%s' "$FIRMWARE_PATHS" > \
        /sys/module/firmware_class/parameters/path || true
fi

log "loading ordered Xiaomi/Qualcomm early modules"
if [ -r "$MODULE_DIR/modules.load" ]; then
    while IFS= read -r module; do
        case "$module" in
            ""|\#*) continue ;;
        esac
        if [ -r "$MODULE_DIR/$module" ]; then
            insmod "$MODULE_DIR/$module" 2>/dev/null || true
        fi
    done <"$MODULE_DIR/modules.load"
else
    log "vendor modules.load not found; continuing with built-in drivers"
fi

log "mounting Kali root from $linux_root"
mount -t ext4 -o rw,noatime "$linux_root" "$ROOT_MOUNT" || \
    emergency_shell "failed to mount linux_root as ext4"

[ -x "$ROOT_MOUNT/sbin/init" ] || \
    emergency_shell "Kali /sbin/init is missing"

mkdir -p "$ROOT_MOUNT/dev" "$ROOT_MOUNT/dev/pts" "$ROOT_MOUNT/proc" \
    "$ROOT_MOUNT/sys" "$ROOT_MOUNT/run" "$ROOT_MOUNT/vendor/firmware_mnt" \
    "$ROOT_MOUNT/vendor/modem_firmware"

if grep -q ' /vendor/firmware_mnt ' /proc/mounts; then
    mount --move /vendor/firmware_mnt "$ROOT_MOUNT/vendor/firmware_mnt" || \
        log "failed to move firmware_mnt into Kali root"
fi
if grep -q ' /vendor/modem_firmware ' /proc/mounts; then
    mount --move /vendor/modem_firmware "$ROOT_MOUNT/vendor/modem_firmware" || \
        log "failed to move modem_firmware into Kali root"
fi
ln -sfn firmware_mnt/image "$ROOT_MOUNT/vendor/firmware"

mount --move /dev "$ROOT_MOUNT/dev"
mount --move /proc "$ROOT_MOUNT/proc"
mount --move /sys "$ROOT_MOUNT/sys"
mount --move /run "$ROOT_MOUNT/run" || true

log "switching to Kali systemd"
exec switch_root "$ROOT_MOUNT" /sbin/init

emergency_shell "switch_root returned unexpectedly"

[Unit]
Description=Xiaomi 14 Pro USB network and SSH management link
After=local-fs.target shennong-hardware.service
Before=NetworkManager.service ssh.service
Wants=ssh.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/shennong-usb-network
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=Xiaomi 14 Pro USB network and SSH management link
DefaultDependencies=no
After=systemd-remount-fs.service shennong-devices.service sys-kernel-config.mount
Before=systemd-udev-trigger.service sysinit.target NetworkManager.service ssh.service
Wants=sys-kernel-config.mount

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/shennong-usb-network
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target

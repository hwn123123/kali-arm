[sm.puri.phosh]
# Keep CLI/security tools visible as well as adaptive mobile applications.
app-filter-mode=[]
favorites=['mate-calc.desktop', 'org.xfce.Parole.desktop',
           'org.xfce.mousepad.desktop', 'kali-nethunter.desktop',
           'atril.desktop', 'org.xfce.ristretto.desktop',
           'org.pulseaudio.pavucontrol.desktop', 'kali-tweaks.desktop',
           'org.gnome.Console.desktop', 'firefox-esr.desktop',
           'thunar.desktop', 'mobi.phosh.MobileSettings.desktop']

[sm.puri.phoc]
auto-maximize=true
scale-to-fit=true

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/shennong/blue-dragon.png'
picture-uri-dark='file:///usr/share/backgrounds/shennong/blue-dragon.png'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/shennong/blue-dragon.png'
picture-options='zoom'

# Phosh ships desktop-specific defaults, which take precedence over the
# generic GNOME keys above. Cover both variants for fresh mobile sessions.
[org.gnome.desktop.background:Phosh]
picture-uri='file:///usr/share/backgrounds/shennong/blue-dragon.png'
picture-uri-dark='file:///usr/share/backgrounds/shennong/blue-dragon.png'
picture-options='zoom'

[org.gnome.desktop.screensaver:Phosh]
picture-uri='file:///usr/share/backgrounds/shennong/blue-dragon.png'
picture-options='zoom'

[org.gnome.settings-daemon.plugins.power]
# Start at the owner's requested maximum instead of applying sensor dimming.
# Normal idle blanking and the interactive brightness slider remain available.
ambient-enabled=false

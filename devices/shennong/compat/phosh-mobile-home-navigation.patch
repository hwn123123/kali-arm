+#define HOME_APPS_PER_PAGE 16
+
+
+static GtkWidget *
+create_home_app_page (PhoshAppGrid *self, guint page_num, guint n_pages, GListModel *apps)
+{
+  GtkWidget *page = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  GtkWidget *scrolled = gtk_scrolled_window_new (NULL, NULL);
+  GtkWidget *flow = gtk_flow_box_new ();
+  GtkWidget *indicator = gtk_label_new (NULL);
+  GListStore *page_apps = g_list_store_new (G_TYPE_OBJECT);
+  guint start = page_num * HOME_APPS_PER_PAGE;
+  guint end = MIN (start + HOME_APPS_PER_PAGE, g_list_model_get_n_items (apps));
+  g_autofree char *page_text = g_strdup_printf ("%u / %u", page_num + 2, n_pages + 1);
+
+  gtk_widget_set_visible (page, TRUE);
+  gtk_widget_set_hexpand (page, TRUE);
+  gtk_widget_set_vexpand (page, TRUE);
+  gtk_style_context_add_class (gtk_widget_get_style_context (page), "phosh-phone-home-app-page");
+
+  gtk_widget_set_visible (scrolled, TRUE);
+  gtk_widget_set_hexpand (scrolled, TRUE);
+  gtk_widget_set_vexpand (scrolled, TRUE);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled), GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_container_add (GTK_CONTAINER (page), scrolled);
+
+  gtk_widget_set_visible (flow, TRUE);
+  gtk_widget_set_hexpand (flow, TRUE);
+  gtk_widget_set_valign (flow, GTK_ALIGN_CENTER);
+  gtk_widget_set_margin_start (flow, 8);
+  gtk_widget_set_margin_end (flow, 8);
+  gtk_widget_set_margin_top (flow, 20);
+  gtk_widget_set_margin_bottom (flow, 20);
+  gtk_flow_box_set_homogeneous (GTK_FLOW_BOX (flow), TRUE);
+  gtk_flow_box_set_min_children_per_line (GTK_FLOW_BOX (flow), 4);
+  gtk_flow_box_set_max_children_per_line (GTK_FLOW_BOX (flow), 4);
+  gtk_flow_box_set_selection_mode (GTK_FLOW_BOX (flow), GTK_SELECTION_NONE);
+  gtk_flow_box_set_activate_on_single_click (GTK_FLOW_BOX (flow), FALSE);
+  gtk_flow_box_set_column_spacing (GTK_FLOW_BOX (flow), 8);
+  gtk_flow_box_set_row_spacing (GTK_FLOW_BOX (flow), 12);
+  gtk_container_add (GTK_CONTAINER (scrolled), flow);
+
+  for (guint i = start; i < end; i++) {
+    GObject *app = g_list_model_get_item (apps, i);
+    if (app) {
+      g_list_store_append (page_apps, app);
+      g_object_unref (app);
+    }
+  }
+  gtk_flow_box_bind_model (GTK_FLOW_BOX (flow), G_LIST_MODEL (page_apps), create_launcher, self, NULL);
+  g_object_unref (page_apps);
+
+  gtk_widget_set_visible (indicator, TRUE);
+  gtk_widget_set_halign (indicator, GTK_ALIGN_CENTER);
+  gtk_widget_set_margin_top (indicator, 6);
+  gtk_widget_set_margin_bottom (indicator, 16);
+  gtk_label_set_text (GTK_LABEL (indicator), page_text);
+  gtk_style_context_add_class (gtk_widget_get_style_context (indicator), "phosh-phone-home-page-indicator");
+  gtk_box_pack_end (GTK_BOX (page), indicator, FALSE, FALSE, 0);
+
+  return page;
+}

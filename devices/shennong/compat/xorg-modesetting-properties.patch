--- a/hw/xfree86/drivers/modesetting/drmmode_display.c
+++ b/hw/xfree86/drivers/modesetting/drmmode_display.c
@@ -2799,0 +2800,10 @@
+    /* Qualcomm topology_control is a BITMASK and has no RandR atoms.
+     * This driver only implements RANGE and ENUM properties. */
+    if (!(prop->flags & (DRM_MODE_PROP_RANGE | DRM_MODE_PROP_ENUM)))
+        return TRUE;
+    /* Android transports fence pointers through 64-bit properties. Do not
+     * truncate them to a 32-bit X11 integer or write them as user controls. */
+    if ((prop->flags & DRM_MODE_PROP_RANGE) &&
+        (prop->count_values != 2 || prop->values[0] > INT32_MAX ||
+         prop->values[1] > INT32_MAX))
+        return TRUE;
@@ -2965 +2975 @@
-        if (p->atoms[0] != property)
+        if (!p->atoms || p->atoms[0] != property)

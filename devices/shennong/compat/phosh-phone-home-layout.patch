+static void
+sync_home_favorites (GListModel *favorites, PhoshAppGrid *self)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+  guint n_items = g_list_model_get_n_items (favorites);
+  guint n_dock_items = MIN (n_items, 4);
+  guint n_shortcuts = n_items - n_dock_items;
+
+  g_list_store_remove_all (priv->home_shortcuts);
+  g_list_store_remove_all (priv->home_dock_items);
+
+  for (guint i = 0; i < n_items; i++) {
+    GObject *app = G_OBJECT (g_list_model_get_item (favorites, i));
+
+    if (i < n_shortcuts)
+      g_list_store_append (priv->home_shortcuts, app);
+    else
+      g_list_store_append (priv->home_dock_items, app);
+
+    g_object_unref (app);
+  }
 }
 

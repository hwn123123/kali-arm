+static GtkWidget *
+create_home_launcher (gpointer item, gpointer self)
+{
+  GtkWidget *btn = phosh_app_grid_button_new (G_APP_INFO (item));
+
+  g_signal_connect (btn, "app-launched", G_CALLBACK (app_launched_cb), self);
+  gtk_widget_set_visible (btn, TRUE);
+
+  return btn;
+}

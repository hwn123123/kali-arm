+static void
+update_home_clock (PhoshWallClock *clock, GParamSpec *pspec, PhoshAppGrid *self)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+  g_autofree char *date = phosh_wall_clock_local_date (clock);
+
+  gtk_label_set_text (GTK_LABEL (priv->home_clock),
+                      phosh_wall_clock_get_clock (clock, TRUE));
+  gtk_label_set_text (GTK_LABEL (priv->home_date), date ?: "");
+}

+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+
+  /* Close any open folder before returning to the home page. */
+  if (priv->open_folder != NULL)
+    show_main_grid (self);
+
+  hdy_deck_set_visible_child_name (HDY_DECK (priv->deck), "phone_home");
+}
